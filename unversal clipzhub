-- Update ESP for a player
local function UpdateESP(player)
    local drawings = ESPDrawings[player]
    if not drawings then return end
    
    if not ShouldESP(player) then
        -- Hide all drawings
        for _, drawing in pairs(drawings) do
            pcall(function() drawing.Visible = false end)
        end
        return
    end
    
    local character = player.Character
    if not character then
        for _, drawing in pairs(drawings) do
            pcall(function() drawing.Visible = false end)
        end
        return
    end
    
    local humanoid = character:FindFirstChild("Humanoid")
    local head = character:FindFirstChild("Head")
    local upperTorso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
    local lowerTorso = character:FindFirstChild("LowerTorso") or character:FindFirstChild("Torso")
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    
    if not head or not humanoidRootPart then
        for _, drawing in pairs(drawings) do
            pcall(function() drawing.Visible = false end)
        end
        return
    end
    
    -- Get screen position
    local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position)
    local rootPos, rootOnScreen = Camera:WorldToViewportPoint(humanoidRootPart.Position)
    
    if not headOnScreen and not rootOnScreen then
        for _, drawing in pairs(drawings) do
            pcall(function() drawing.Visible = false end)
        end
        return
    end
    
    local color = GetESPColor(player)
    
    -- Calculate box dimensions
    local topPos = headPos
    local bottomPos = rootPos
    
    -- Add some padding
    local boxHeight = math.abs(topPos.Y - bottomPos.Y) * 1.5
    local boxWidth = boxHeight * 0.6
    
    local boxX = topPos.X - boxWidth / 2
    local boxY = topPos.Y - boxHeight * 0.15
    
    -- Box ESP
    if drawings.Box then
        drawings.Box.Size = Vector2.new(boxWidth, boxHeight)
        drawings.Box.Position = Vector2.new(boxX, boxY)
        drawings.Box.Color = color
        drawings.Box.Visible = true
    end
    
    -- Name ESP
    if drawings.Name then
        drawings.Name.Text = player.Name
        drawings.Name.Position = Vector2.new(topPos.X, boxY - 18)
        drawings.Name.Color = color
        drawings.Name.Visible = true
    end
    
    -- Health ESP
    if drawings.HealthBar and humanoid then
        local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
        local barHeight = boxHeight
        local barX = boxX - 8
        
        drawings.HealthBarBG.From = Vector2.new(barX, boxY)
        drawings.HealthBarBG.To = Vector2.new(barX, boxY + barHeight)
        drawings.HealthBarBG.Visible = true
        
        drawings.HealthBar.From = Vector2.new(barX, boxY + barHeight * (1 - healthPercent))
        drawings.HealthBar.To = Vector2.new(barX, boxY + barHeight)
        drawings.HealthBar.Color = Color3.fromRGB(255 * (1 - healthPercent), 255 * healthPercent, 0)
        drawings.HealthBar.Visible = true
    end
    
    -- Distance ESP
    if drawings.Distance and humanoidRootPart then
        local distance = (humanoidRootPart.Position - Camera.CFrame.Position).Magnitude
        drawings.Distance.Text = math.floor(distance) .. " studs"
        drawings.Distance.Position = Vector2.new(topPos.X, boxY + boxHeight + 2)
        drawings.Distance.Color = color
        drawings.Distance.Visible = true
    end
    
    -- Skeleton ESP
    if Settings.ESPSkeleton and upperTorso and lowerTorso then
        local function getPartPos(partName)
            local part = character:FindFirstChild(partName)
            if part then
                local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    return Vector2.new(pos.X, pos.Y)
                end
            end
            return nil
        end
        
        local headScreen = getPartPos("Head")
        local upperTorsoScreen = getPartPos("UpperTorso") or getPartPos("Torso")
        local lowerTorsoScreen = getPartPos("LowerTorso") or getPartPos("Torso")
        local leftArmScreen = getPartPos("LeftHand") or getPartPos("Left Arm")
        local rightArmScreen = getPartPos("RightHand") or getPartPos("Right Arm")
        local leftLegScreen = getPartPos("LeftFoot") or getPartPos("Left Leg")
        local rightLegScreen = getPartPos("RightFoot") or getPartPos("Right Leg")
        
        if drawings.SkeletonHead and headScreen and upperTorsoScreen then
            drawings.SkeletonHead.From = headScreen
            drawings.SkeletonHead.To = upperTorsoScreen
            drawings.SkeletonHead.Color = color
            drawings.SkeletonHead.Visible = true
        end
        
        if drawings.SkeletonTorso and upperTorsoScreen and lowerTorsoScreen then
            drawings.SkeletonTorso.From = upperTorsoScreen
            drawings.SkeletonTorso.To = lowerTorsoScreen
            drawings.SkeletonTorso.Color = color
            drawings.SkeletonTorso.Visible = true
        end
        
        if drawings.SkeletonLeftArm and upperTorsoScreen and leftArmScreen then
            drawings.SkeletonLeftArm.From = upperTorsoScreen
            drawings.SkeletonLeftArm.To = leftArmScreen
            drawings.SkeletonLeftArm.Color = color
            drawings.SkeletonLeftArm.Visible = true
        end
        
        if drawings.SkeletonRightArm and upperTorsoScreen and rightArmScreen then
            drawings.SkeletonRightArm.From = upperTorsoScreen
            drawings.SkeletonRightArm.To = rightArmScreen
            drawings.SkeletonRightArm.Color = color
            drawings.SkeletonRightArm.Visible = true
        end
        
        if drawings.SkeletonLeftLeg and lowerTorsoScreen and leftLegScreen then
            drawings.SkeletonLeftLeg.From = lowerTorsoScreen
            drawings.SkeletonLeftLeg.To = leftLegScreen
            drawings.SkeletonLeftLeg.Color = color
            drawings.SkeletonLeftLeg.Visible = true
        end
        
        if drawings.SkeletonRightLeg and lowerTorsoScreen and rightLegScreen then
            drawings.SkeletonRightLeg.From = lowerTorsoScreen
            drawings.SkeletonRightLeg.To = rightLegScreen
            drawings.SkeletonRightLeg.Color = color
            drawings.SkeletonRightLeg.Visible = true
        end
    end
end

-- Update all ESP
local function UpdateAllESP()
    if not Settings.ESPEnabled then
        for player, drawings in pairs(ESPDrawings) do
            for _, drawing in pairs(drawings) do
                pcall(function() drawing.Visible = false end)
            end
        end
        return
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if ShouldESP(player) then
            CreateESP(player)
            UpdateESP(player)
        else
            if ESPDrawings[player] then
                for _, drawing in pairs(ESPDrawings[player]) do
                    pcall(function() drawing.Visible = false end)
                end
            end
        end
    end
end

-- Start ESP loop
local function StartESP()
    if ESPConnection then return end
    
    ESPConnection = RunService.RenderStepped:Connect(function()
        UpdateAllESP()
    end)
end

-- Stop ESP
local function StopESP()
    if ESPConnection then
        ESPConnection:Disconnect()
        ESPConnection = nil
    end
    
    for player, drawings in pairs(ESPDrawings) do
        for _, drawing in pairs(drawings) do
            pcall(function() drawing.Visible = false end)
        end
    end
end

-- Toggle ESP
local function ToggleESP()
    Settings.ESPEnabled = not Settings.ESPEnabled
    getgenv().ESPEnabled = Settings.ESPEnabled
    SaveSettings()
    
    if Settings.ESPEnabled then
        StartESP()
        print("👁️ ESP ENABLED")
    else
        StopESP()
        print("👁️ ESP DISABLED")
    end
    
    UpdateESPToggle()
    return Settings.ESPEnabled
end

