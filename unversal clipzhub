        return false
    end
    
    local decoded = HttpService:JSONDecode(data)
    if not decoded then
        return false
    end
    
    for key, value in pairs(decoded) do
        if key == "ProtectedPlayers" then
            ProtectedPlayers = value or {}
            ProtectedPlayersSet = {}
            for _, name in ipairs(ProtectedPlayers) do
                ProtectedPlayersSet[name] = true
            end
            Settings.ProtectedPlayers = ProtectedPlayers
