    nc.Parent = notifyFrame

    local ns = Instance.new("UIStroke")
    ns.Color = Color3.fromRGB(200, 0, 0)
    ns.Thickness = 2
    ns.Parent = notifyFrame

    local nl = Instance.new("TextLabel")
    nl.Size = UDim2.new(1, -20, 1, 0)
    nl.Position = UDim2.new(0, 10, 0, 0)
    nl.BackgroundTransparency = 1
    nl.Text = text
    nl.TextColor3 = Color3.fromRGB(255, 255, 255)
    nl.TextSize = 15
    nl.Font = Enum.Font.GothamBold
    nl.Parent = notifyFrame

    TweenService:Create(notifyFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, -120, 0, 20)
    }):Play()
    task.delay(2.5, function()
        TweenService:Create(notifyFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0.5, -120, 0, -60)
        }):Play()
        task.delay(0.5, function()
            notifyFrame:Destroy()
        end)
    end)
end

