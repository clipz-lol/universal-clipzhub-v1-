local function refreshPlayerList()
    for _, child in ipairs(scrollFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local sorted = {}
    for _, p in ipairs(Players:GetPlayers()) do
        table.insert(sorted, p)
    end
    table.sort(sorted, function(a, b)
        if a == player then return true end
        if b == player then return false end
        return a.Name:lower() < b.Name:lower()
    end)

    local order = 0
    for _, p in ipairs(sorted) do
        order = order + 1
        local row = createPlayerRow(p, order)
        if p == player then
            row.BackgroundColor3 = Color3.fromRGB(60, 0, 0)
            local tpBtn = row:FindFirstChild("TextButton")
            if tpBtn then
                tpBtn.Text = "YOU"
                tpBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
                tpBtn.Active = false
            end
        end
    end

    task.defer(function()
        local layoutHeight = scrL.AbsoluteContentSize.Y
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, layoutHeight + 12)
    end)
end

