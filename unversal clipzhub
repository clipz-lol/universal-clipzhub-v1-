local function setActiveTab(tab)
    mainContent.Visible = (tab == "main")
    tpContent.Visible = (tab == "teleport")
    aimContent.Visible = (tab == "aimbot")
    espContent.Visible = (tab == "esp")
    cfgContent.Visible = (tab == "config")

    local tabs = {
        {btn = mainTabButton, stroke = mainTabStroke, key = "main"},
        {btn = tpTabButton, stroke = tpTabStroke, key = "teleport"},
        {btn = aimTabButton, stroke = aimTabStroke, key = "aimbot"},
        {btn = espTabButton, stroke = espTabStroke, key = "esp"},
        {btn = cfgTabButton, stroke = cfgTabStroke, key = "config"},
    }
    for _, t in ipairs(tabs) do
        if t.key == tab then
            t.btn.BackgroundColor3 = Color3.fromRGB(120, 0, 0)
            t.btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            t.stroke.Color = Color3.fromRGB(255, 50, 50)
        else
            t.btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            t.btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            t.stroke.Color = Color3.fromRGB(80, 0, 0)
        end
    end
    if tab == "teleport" then
        refreshPlayerList()
    end
    if tab == "config" then
        refreshSlot1()
        refreshSlot2()
    end
end

