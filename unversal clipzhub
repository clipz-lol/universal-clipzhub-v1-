-- Slot builder
local function buildSlot(parent, yPos, getSlotNum)
    local slotFrame = Instance.new("Frame")
    slotFrame.Size = UDim2.new(1, 0, 0, 70)
    slotFrame.Position = UDim2.new(0, 0, 0, yPos)
    slotFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    slotFrame.BorderSizePixel = 0
    slotFrame.Parent = parent

    local sc = Instance.new("UICorner")
    sc.CornerRadius = UDim.new(0, 6)
    sc.Parent = slotFrame

    local ss = Instance.new("UIStroke")
    ss.Color = Color3.fromRGB(80, 0, 0)
    ss.Thickness = 1.5
    ss.Parent = slotFrame

    local nameBox = Instance.new("TextBox")
    nameBox.Size = UDim2.new(1, -100, 0, 24)
    nameBox.Position = UDim2.new(0, 6, 0, 6)
    nameBox.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    nameBox.Text = (getSlotNum() == 1) and slot1Name or slot2Name
    nameBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameBox.TextSize = 12
    nameBox.Font = Enum.Font.GothamBold
    nameBox.BorderSizePixel = 0
    nameBox.ClearTextOnFocus = false
    nameBox.PlaceholderText = "Slot Name"
    nameBox.PlaceholderColor3 = Color3.fromRGB(120, 120, 120)
    nameBox.Parent = slotFrame

    local nbc = Instance.new("UICorner")
    nbc.CornerRadius = UDim.new(0, 4)
    nbc.Parent = nameBox

    local nbs = Instance.new("UIStroke")
    nbs.Color = Color3.fromRGB(80, 0, 0)
    nbs.Thickness = 1
    nbs.Parent = nameBox

    local statusLbl = Instance.new("TextLabel")
    statusLbl.Size = UDim2.new(1, -100, 0, 14)
    statusLbl.Position = UDim2.new(0, 8, 0, 34)
    statusLbl.BackgroundTransparency = 1
    statusLbl.Text = "Empty"
    statusLbl.TextColor3 = Color3.fromRGB(150, 150, 150)
    statusLbl.TextSize = 10
    statusLbl.Font = Enum.Font.Gotham
    statusLbl.TextXAlignment = Enum.TextXAlignment.Left
    statusLbl.Parent = slotFrame

    local btnHolder = Instance.new("Frame")
    btnHolder.Size = UDim2.new(0, 90, 0, 60)
    btnHolder.Position = UDim2.new(1, -96, 0, 5)
    btnHolder.BackgroundTransparency = 1
    btnHolder.Parent = slotFrame

    local function makeBtn(text, xPos, yPos, color)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0, 42, 0, 26)
        b.Position = UDim2.new(0, xPos, 0, yPos)
        b.BackgroundColor3 = color or Color3.fromRGB(120, 0, 0)
        b.Text = text
        b.TextColor3 = Color3.fromRGB(255, 255, 255)
        b.TextSize = 10
        b.Font = Enum.Font.GothamBold
        b.BorderSizePixel = 0
        b.AutoButtonColor = false
        b.Parent = btnHolder
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 4)
        c.Parent = b
        return b
    end

    local saveBtn = makeBtn("SAVE", 0, 0, Color3.fromRGB(120, 0, 0))
    local loadBtn = makeBtn("LOAD", 48, 0, Color3.fromRGB(0, 100, 0))
    local clearBtn = makeBtn("CLEAR", 24, 30, Color3.fromRGB(60, 0, 0))

    local function refreshUI()
        local n = getSlotNum()
        local nm = (n == 1) and slot1Name or slot2Name
        local pos = (n == 1) and slot1Pos or slot2Pos
        nameBox.Text = nm
        if pos then
            statusLbl.Text = string.format("Saved: %.1f, %.1f, %.1f", pos.x, pos.y, pos.z)
            statusLbl.TextColor3 = Color3.fromRGB(0, 220, 0)
        else
            statusLbl.Text = "Empty"
            statusLbl.TextColor3 = Color3.fromRGB(150, 150, 150)
        end
    end

    nameBox.FocusLost:Connect(function()
        local n = getSlotNum()
        local newName = nameBox.Text
        if newName == "" then newName = "Slot " .. n end
        if n == 1 then slot1Name = newName else slot2Name = newName end
        nameBox.Text = newName
        saveConfig()
    end)

    saveBtn.MouseButton1Click:Connect(function()
        local n = getSlotNum()
        if not rootPart or not rootPart.Parent then
            showNotification("Cannot save - no character")
            return
        end
        local p = rootPart.Position
        local posData = {x = p.X, y = p.Y, z = p.Z}
        if n == 1 then
            slot1Pos = posData
            slot1Name = nameBox.Text ~= "" and nameBox.Text or "Slot 1"
        else
            slot2Pos = posData
            slot2Name = nameBox.Text ~= "" and nameBox.Text or "Slot 2"
        end
        saveConfig()
        refreshUI()
        showNotification("Saved to " .. ((n == 1) and slot1Name or slot2Name))
    end)

    loadBtn.MouseButton1Click:Connect(function()
        local n = getSlotNum()
        local pos = (n == 1) and slot1Pos or slot2Pos
        if not pos then
            showNotification("Slot is empty")
            return
        end
        if not rootPart or not rootPart.Parent then
            showNotification("Cannot teleport - no character")
            return
        end
        rootPart.CFrame = CFrame.new(pos.x, pos.y, pos.z)
        showNotification("Teleported to " .. ((n == 1) and slot1Name or slot2Name))
    end)

    clearBtn.MouseButton1Click:Connect(function()
        local n = getSlotNum()
        if n == 1 then
            slot1Pos = nil
        else
            slot2Pos = nil
        end
        saveConfig()
        refreshUI()
        showNotification("Slot cleared")
    end)

    refreshUI()
    return slotFrame, refreshUI
end

