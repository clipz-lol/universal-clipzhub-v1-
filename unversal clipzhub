            Settings.FOVShape = value
        elseif key == "FOVTransparency" then
            Settings.FOVTransparency = value
        elseif key == "FOVColor" then
            Settings.FOVColor = value
        elseif key == "FOVBorderSize" then
            Settings.FOVBorderSize = value
        elseif key == "ESPCustomColor" then
            Settings.ESPCustomColor = value
        elseif string.match(key, "Keybind_") then
            Settings[key] = value
        else
            getgenv()[key] = value
            Settings[key] = value
        end
    end
    
    Keybinds.ToggleAimbot = StringToKeyCode(Settings.Keybind_ToggleAimbot)
    Keybinds.ToggleFly = StringToKeyCode(Settings.Keybind_ToggleFly)
