-- ============================================
-- RAPID FIRE - SIMPLIFIED WORKING VERSION
-- ============================================

local RapidFireRunning = false
local RapidFireConnection = nil
local RapidFireLastFireTime = 0

local function FireGun()
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(Vector2.new(0, 0), 0, true, Enum.UserInputType.MouseButton1, 0)
        VirtualInputManager:SendMouseButtonEvent(Vector2.new(0, 0), 0, false, Enum.UserInputType.MouseButton1, 0)
    end)
end

local function StartRapidFire()
    if RapidFireRunning then return end
    if not getgenv().RapidFireEnabled then return end
    
    RapidFireRunning = true
    RapidFireLastFireTime = 0
    print("🔫 Rapid Fire ENABLED")
    
    local fireDelay = getgenv().RapidFireDelay or 0.05
    
    RapidFireConnection = RunService.Heartbeat:Connect(function()
        if not getgenv().RapidFireEnabled then
            StopRapidFire()
            return
        end
        
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            local currentTime = tick()
            if currentTime - RapidFireLastFireTime >= fireDelay then
                FireGun()
                RapidFireLastFireTime = currentTime
            end
        end
    end)
end

local function StopRapidFire()
    if RapidFireConnection then
        RapidFireConnection:Disconnect()
        RapidFireConnection = nil
    end
    RapidFireRunning = false
    print("🔫 Rapid Fire DISABLED")
end

local function ToggleRapidFire()
    getgenv().RapidFireEnabled = not getgenv().RapidFireEnabled
    Settings.RapidFireEnabled = getgenv().RapidFireEnabled
    SaveSettings()
    
    if getgenv().RapidFireEnabled then
        StartRapidFire()
    else
        StopRapidFire()
    end
    
    UpdateRapidFireButton()
    return getgenv().RapidFireEnabled
end

local function UpdateRapidFireButton()
    if MainFrame then
        for _, child in pairs(MainFrame:GetDescendants()) do
            if child:IsA("TextButton") and child.Name == "RapidFireBtn" then
                child.Text = "🔫 Rapid Fire: " .. (getgenv().RapidFireEnabled and "ON" or "OFF")
                child.TextColor3 = getgenv().RapidFireEnabled and Color3.fromRGB(255, 100, 0) or Color3.fromRGB(0, 255, 150)
                child.BorderColor3 = getgenv().RapidFireEnabled and Color3.fromRGB(255, 100, 0) or Color3.fromRGB(0, 255, 150)
                break
            end
        end
    end
end

