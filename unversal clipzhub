-- ============================================
-- KEYBIND HANDLER
-- ============================================

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.RightShift then
        GuiVisible = not GuiVisible
        if MainFrame then
            MainFrame.Visible = GuiVisible
        end
        return
    end
    
    if WaitingForKeybind and input.KeyCode ~= Enum.KeyCode.Unknown then
        local key = input.KeyCode
        local action = WaitingForKeybindAction
        local button = WaitingForKeybindButton
        
        if key == Enum.KeyCode.RightShift then
            print("❌ Cannot bind the menu key (Right Shift)")
            if SaveStatusLabel then
                SaveStatusLabel.Text = "❌ Cannot bind the menu key (Right Shift)"
                SaveStatusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
                SaveStatusLabel.Visible = true
                task.delay(2, function()
                    if SaveStatusLabel then
                        SaveStatusLabel.Visible = false
                    end
                end)
            end
            WaitingForKeybind = false
            WaitingForKeybindAction = nil
            WaitingForKeybindButton = nil
            if button then
                local displayName = action:gsub("Toggle", ""):gsub("(Aimbot)", "Aimbot"):gsub("(Fly)", "Fly"):gsub("(Noclip)", "Noclip"):gsub("TeleportToTarget", "Teleport"):gsub("BringTarget", "Bring"):gsub("RapidFire", "Rapid Fire"):gsub("(ESP)", "ESP")
                button.Text = displayName .. ": " .. (Keybinds[action] and KeyCodeToString(Keybinds[action]) or "None")
                button.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
            end
            return
        end
        
        Keybinds[action] = key
        Settings["Keybind_" .. action] = KeyCodeToString(key)
        SaveSettings()
        
        if button then
            local displayName = action:gsub("Toggle", ""):gsub("(Aimbot)", "Aimbot"):gsub("(Fly)", "Fly"):gsub("(Noclip)", "Noclip"):gsub("TeleportToTarget", "Teleport"):gsub("BringTarget", "Bring"):gsub("RapidFire", "Rapid Fire"):gsub("(ESP)", "ESP")
            button.Text = displayName .. ": " .. KeyCodeToString(key)
            button.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
        end
        
        print("✅ Bound " .. action .. " to " .. KeyCodeToString(key))
        if SaveStatusLabel then
            SaveStatusLabel.Text = "✅ Bound " .. action .. " to " .. KeyCodeToString(key)
            SaveStatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
            SaveStatusLabel.Visible = true
            task.delay(2, function()
                if SaveStatusLabel then
                    SaveStatusLabel.Visible = false
                end
            end)
        end
        
        WaitingForKeybind = false
        WaitingForKeybindAction = nil
        WaitingForKeybindButton = nil
        return
    end
    
    -- Toggle Aimbot
    if Keybinds.ToggleAimbot and input.KeyCode == Keybinds.ToggleAimbot and not KeybindDebounce.ToggleAimbot then
        KeybindDebounce.ToggleAimbot = true
        local newState = not getgenv().AimbotEnabled
        getgenv().AimbotEnabled = newState
        Settings.AimbotEnabled = newState
        SaveSettings()
        
        if MainFrame then
            for _, child in pairs(MainFrame:GetDescendants()) do
                if child:IsA("TextButton") and child.Text and child.Text:find("Aimbot:") then
                    child.Text = "Aimbot: " .. (newState and "ON" or "OFF")
                    break
                end
            end
        end
        
        if SaveStatusLabel then
            SaveStatusLabel.Text = "🎯 Aimbot " .. (newState and "ON" or "OFF")
            SaveStatusLabel.TextColor3 = newState and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 100, 100)
            SaveStatusLabel.Visible = true
            task.delay(1.5, function()
                if SaveStatusLabel then
                    SaveStatusLabel.Visible = false
                end
            end)
        end
        
        print("Aimbot " .. (newState and "ENABLED" or "DISABLED"))
        task.delay(0.2, function()
            KeybindDebounce.ToggleAimbot = false
        end)
        return
    end
    
