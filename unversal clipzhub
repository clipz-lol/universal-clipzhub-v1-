local function ShowRenamePrompt(slotNumber)
    if RenameTextBox then
        RenameTextBox:Destroy()
        RenameTextBox = nil
    end
    
    RenameSlotNumber = slotNumber
    
    local slotContainer = nil
    for _, slot in ipairs(SlotButtons) do
        if slot.Number == slotNumber then
            slotContainer = slot.Container
            break
        end
    end
    
    if not slotContainer then return end
    
    RenameTextBox = Instance.new("TextBox")
    RenameTextBox.Size = UDim2.new(1, -10, 0, 25)
    RenameTextBox.Position = UDim2.new(0, 5, 0.5, -12)
    RenameTextBox.Text = GetSlotName(slotNumber)
    RenameTextBox.TextColor3 = Color3.fromRGB(0, 255, 0)
    RenameTextBox.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    RenameTextBox.BackgroundTransparency = 0.2
    RenameTextBox.Font = Enum.Font.GothamBold
    RenameTextBox.TextSize = 11
    RenameTextBox.Parent = slotContainer
    RenameTextBox.ZIndex = 10
    RenameTextBox.ClearTextOnFocus = false
    
    RenameTextBox:CaptureFocus()
    
    RenameTextBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            local newName = RenameTextBox.Text
            if newName and newName ~= "" then
                SetSlotName(slotNumber, newName)
                local newInfo = GetSlotInfo(slotNumber)
                for _, slot in ipairs(SlotButtons) do
                    if slot.Number == slotNumber then
                        slot.InfoLabel.Text = newInfo
                        break
                    end
                end
                
                if SaveStatusLabel then
                    SaveStatusLabel.Text = "✅ Slot " .. slotNumber .. " renamed to '" .. newName .. "'"
                    SaveStatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
                    SaveStatusLabel.Visible = true
                    task.delay(2, function()
                        if SaveStatusLabel then
                            SaveStatusLabel.Visible = false
                        end
                    end)
                end
                print("📝 Renamed Slot " .. slotNumber .. " to '" .. newName .. "'")
            end
        end
        if RenameTextBox then
            RenameTextBox:Destroy()
            RenameTextBox = nil
        end
    end)
end

