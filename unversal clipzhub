            SaveStatusLabel.Text = "🔄 Bringing " .. lockedTarget.Name
            SaveStatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
            SaveStatusLabel.Visible = true
            task.delay(1.5, function()
                if SaveStatusLabel then
                    SaveStatusLabel.Visible = false
                end
            end)
        end
        
        BringPlayer(lockedTarget)
        task.delay(0.3, function()
            KeybindDebounce.BringTarget = false
        end)
        return
    end
    
    -- Toggle Rapid Fire
    if Keybinds.ToggleRapidFire and input.KeyCode == Keybinds.ToggleRapidFire and not KeybindDebounce.ToggleRapidFire then
        KeybindDebounce.ToggleRapidFire = true
        ToggleRapidFire()
        
        if SaveStatusLabel then
            SaveStatusLabel.Text = "🔫 Rapid Fire " .. (getgenv().RapidFireEnabled and "ON" or "OFF")
            SaveStatusLabel.TextColor3 = getgenv().RapidFireEnabled and Color3.fromRGB(255, 100, 0) or Color3.fromRGB(255, 100, 100)
            SaveStatusLabel.Visible = true
            task.delay(1.5, function()
                if SaveStatusLabel then
                    SaveStatusLabel.Visible = false
                end
            end)
        end
        
        task.delay(0.2, function()
            KeybindDebounce.ToggleRapidFire = false
        end)
        return
    end
end)

