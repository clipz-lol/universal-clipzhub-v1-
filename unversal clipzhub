-- ===== SAFE CONFIG =====
local HAS_FILE_IO = (typeof(writefile) == "function" and typeof(readfile) == "function")
local CONFIG_FILE = "ClipzHub_config.json"

local function loadConfig()
    local defaults = {
        FLY_SPEED = 50,
        WALK_SPEED = 16,
        JUMP_POWER = 50,
        aimbotEnabled = false,
        aimbotTeamCheck = false,
        aimbotWallCheck = false,
        aimbotFOV = 150,
        aimbotSmoothing = 0.25,
        espEnabled = false,
        espTeamCheck = false,
        espShowName = true,
        espShowDistance = true,
        espShowHealth = true,
        autoLoadOnTeleport = true,
        invisibilityEnabled = false,
        slot1Name = "Slot 1",
        slot1Pos = nil,
        slot2Name = "Slot 2",
        slot2Pos = nil,
    }
    if not HAS_FILE_IO then return defaults end
    local ok, data = pcall(function()
        if isfile and isfile(CONFIG_FILE) then
            return game:GetService("HttpService"):JSONDecode(readfile(CONFIG_FILE))
        end
        return nil
    end)
    if ok and type(data) == "table" then
        for k, v in pairs(data) do
            defaults[k] = v
        end
    end
    return defaults
end

local function saveConfig()
    if not HAS_FILE_IO then return end
    local data = {
        FLY_SPEED = FLY_SPEED,
        WALK_SPEED = WALK_SPEED,
        JUMP_POWER = JUMP_POWER,
        aimbotEnabled = aimbotEnabled,
        aimbotTeamCheck = aimbotTeamCheck,
        aimbotWallCheck = aimbotWallCheck,
        aimbotFOV = aimbotFOV,
        aimbotSmoothing = aimbotSmoothing,
        espEnabled = espEnabled,
        espTeamCheck = espTeamCheck,
        espShowName = espShowName,
        espShowDistance = espShowDistance,
        espShowHealth = espShowHealth,
        autoLoadOnTeleport = autoLoadOnTeleport,
        invisibilityEnabled = invisibilityEnabled,
        slot1Name = slot1Name,
        slot1Pos = slot1Pos,
        slot2Name = slot2Name,
        slot2Pos = slot2Pos,
    }
    pcall(function()
        writefile(CONFIG_FILE, game:GetService("HttpService"):JSONEncode(data))
    end)
end

