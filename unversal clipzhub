RunService.RenderStepped:Connect(function()
    if not espEnabled then
        for _, data in pairs(espBoxes) do
            if data.box then data.box.Visible = false end
        end
        return
    end

    for targetPlayer, data in pairs(espBoxes) do
        local skip = false
        if not data.box or not data.box.Parent then
            skip = true
        end
        if targetPlayer == player then skip = true end
        if espTeamCheck and targetPlayer.Team == player.Team then skip = true end
        local targetChar = targetPlayer.Character
        if not targetChar then skip = true end

        if skip then
            if data.box then data.box.Visible = false end
        else
            local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")
            local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
            local head = targetChar:FindFirstChild("Head")

            if not targetHumanoid or not targetRoot or targetHumanoid.Health <= 0 then
                data.box.Visible = false
            else
                local topPart = head or targetRoot
                local bottomPos = targetRoot.Position - Vector3.new(0, 3, 0)
                local topPos = topPart.Position + Vector3.new(0, 1, 0)
                local topScreen, topOnScreen = Camera:WorldToViewportPoint(topPos)
                local bottomScreen, bottomOnScreen = Camera:WorldToViewportPoint(bottomPos)

                if not topOnScreen and not bottomOnScreen then
                    data.box.Visible = false
                else
                    local topVec = Vector2.new(topScreen.X, topScreen.Y)
                    local bottomVec = Vector2.new(bottomScreen.X, bottomScreen.Y)
                    local height = math.abs(bottomVec.Y - topVec.Y)
                    local width = height * 0.55
                    local centerX = (topVec.X + bottomVec.X) / 2
                    local minY = math.min(topVec.Y, bottomVec.Y)

                    if height < 2 then
                        data.box.Visible = false
                    else
                        data.box.Visible = true
                        data.box.Size = UDim2.new(0, width, 0, height)
                        data.box.Position = UDim2.new(0, centerX - width / 2, 0, minY)

                        if espShowName then
                            data.nameLabel.Visible = true
                            data.nameLabel.Text = targetPlayer.Name
                            data.nameLabel.Size = UDim2.new(1, 60, 0, 16)
                            data.nameLabel.Position = UDim2.new(0.5, -width / 2 - 30, 0, -20)
                        else
                            data.nameLabel.Visible = false
                        end

                        if espShowDistance then
                            data.distLabel.Visible = true
                            local dist = (Camera.CFrame.Position - targetRoot.Position).Magnitude
                            data.distLabel.Text = math.floor(dist) .. "m"
                            data.distLabel.Size = UDim2.new(1, 60, 0, 14)
                            data.distLabel.Position = UDim2.new(0.5, -width / 2 - 30, 0, -6)
                        else
                            data.distLabel.Visible = false
                        end

                        if espShowHealth then
                            data.healthBarBg.Visible = true
                            data.healthBarBg.Size = UDim2.new(0, 3, 1, 0)
                            data.healthBarBg.Position = UDim2.new(0, -7, 0, 0)
                            local hp = math.clamp(targetHumanoid.Health / targetHumanoid.MaxHealth, 0, 1)
                            data.healthBar.Size = UDim2.new(1, 0, hp, 0)
                            data.healthBar.Position = UDim2.new(0, 0, 1 - hp, 0)
                            local color
                            if hp > 0.5 then
                                color = Color3.fromRGB(255 * (1 - (hp - 0.5) * 2), 255, 0)
                            else
                                color = Color3.fromRGB(255, 255 * (hp * 2), 0)
                            end
                            data.healthBar.BackgroundColor3 = color
                        else
                            data.healthBarBg.Visible = false
                        end
                    end
                end
            end
        end
    end
end)

-- ===== AUTO-RELOAD ON TELEPORT =====
RunService.Heartbeat:Connect(function()
    if not autoLoadOnTeleport then return end
    if not rootPart or not rootPart.Parent then return end
    local currentPos = rootPart.Position
    if lastPosition then
        local delta = (currentPos - lastPosition).Magnitude
        if delta > 100 then
            task.wait(0.5)
            if noclip and character then
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
            if walkSpeedEnabled then applyWalkSpeed() end
            if jumpPowerEnabled then applyJumpPower() end
            if espEnabled then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= player and not espBoxes[p] then
                        createESP(p)
                    end
                end
            end
            if invisibilityEnabled then
                task.wait(0.5)
                setInvisibility(true)
            end
        end
    end
    lastPosition = currentPos
end)

